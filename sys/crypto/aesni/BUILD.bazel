# The kernel's compile groups for sys/crypto/aesni (run 2026-10-09: one package
# per kernel source directory; the reference's link-line object
# order is carried by the kernel link's deps list).
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*"], allow_empty = True))

# The directory's headers, for the kernel's -Isys include
# surface: root kernel_headers / sys_headers take this carrier
# across the package boundary (their glob stops here).
filegroup(
    name = "headers",
    srcs = glob(["**/*.h", "**/*.inc"], allow_empty = True),
)

cc_per_source_library(
    name = "cc_002",
    features = ["kernel_compile_flags"],
    copts = [
        "-x",
        "assembler-with-cpp",
        "-DLOCORE",
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror"
    ],
    srcs = [
        "aeskeys_amd64.S",
    ],
    hdrs = [
        "//sys/amd64/ia32:ia32_exception.S",
        "//sys/amd64/amd64:apic_vector.S",
        "//sys/amd64/amd64:atpic_vector.S",
        "//sys/BZL:assym_inc",
        "//sys/BZL:ia32_assym",

        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
cc_per_source_library(
    name = "cc_003",
    features = ["kernel_compile_flags"],
    copts = [
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror"
    ],
    srcs = [
        "aesni.c",
    ],
    hdrs = [
        "//sys/BZL:offset_inc",
        "//sys/BZL:vdso",
        "//sys/BZL:vdso_ia32",
        "//sys/BZL:acpi_wakecode",

        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    additional_compiler_inputs = [
        "//sys/kern:imgact_elf.c",
        "//sys/kern:kern_ctf.c",
        "//sys/libkern:qsort.c",
        "//sys/kern:subr_busdma_bounce.c",
        "//sys/kern:subr_syscall.c",
        "//sys/dev/xen/netback:netback_unit_tests.c",
        "//sys/crypto/chacha20:chacha.c",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
cc_per_source_library(
    name = "cc_055",
    features = ["kernel_compile_flags"],
    copts = [
        "-O3",
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror",
        "-Wno-error=cast-qual",
        "-mmmx",
        "-msse",
        "-msse4",
        "-maes",
        "-mpclmul",
        "-isystem",
        "external/+kernel_llvm_toolchain+kernel_llvm/resource_include",
    ],
    srcs = [
        "aesni_ccm.c",
        "aesni_ghash.c",
    ],
    hdrs = [
        "//sys/BZL:offset_inc",
        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
        "@kernel_llvm//:clang_builtins",
    ],
)
cc_per_source_library(
    name = "cc_056",
    features = ["kernel_compile_flags"],
    copts = [
        "-O3",
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror",
