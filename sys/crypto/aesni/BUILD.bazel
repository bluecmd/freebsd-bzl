        "-mmmx",
        "-msse",
        "-msse4",
        "-maes",
        "-isystem",
        "external/+kernel_llvm_toolchain+kernel_llvm/resource_include",
    ],
    srcs = [
        "aesni_wrap.c",
    ],
    hdrs = [
        "//sys/BZL:offset_inc",
        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
