# The rpctlscd/rpctlssd rpcgen outputs, as kern.pre.mk's RPCGEN rules run
# them (rpcgen preprocesses through $CPP; the reference's cpp is the
# toolchain's clang-cpp).
genrule(
    name = "rpctlscd_gen",
    srcs = ["//:sys/rpc/rpcsec_tls/rpctlscd.x"],
    outs = [
        "rpctlscd.h",
        "rpctlscd_xdr.c",
        "rpctlscd_clnt.c",
    ],
    cmd = """
        RG=$$PWD/$(location //usr.bin/rpcgen:rpcgen)
        CPPB=$$PWD/$(location @kernel_llvm//:bin/clang-cpp)
        X=$$PWD/$(location //:sys/rpc/rpcsec_tls/rpctlscd.x)
        OUT=$$PWD/$(RULEDIR)
        mkdir t && cd t
        export CPP="$$CPPB -target x86_64-unknown-freebsd15.1 -B$$(dirname $$CPPB)"
        "$$RG" -hM "$$X" | grep -v pthread.h > "$$OUT/rpctlscd.h"
        "$$RG" -c "$$X" -o "$$OUT/rpctlscd_xdr.c"
        "$$RG" -lM "$$X" | grep -v string.h > "$$OUT/rpctlscd_clnt.c"
        cd .. && rm -rf t
    """,
    tools = [
        "//usr.bin/rpcgen:rpcgen",
        "@kernel_llvm//:bin/clang-cpp",
