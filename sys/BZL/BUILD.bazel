# vnode_if_newproto.h, the -p pass of sys/tools/vnode_if.awk over
# sys/kern/vnode_if.src (sys/conf/kern.mk's four awk stages).

# vnode_if_typedef.h, the -q pass of the same script.

# vnode_if.c, the -c pass of the same script.
awk_generate(
    name = "vnode_if",
    src = "//sys/kern:vnode_if.src",
    script = "//:sys/tools/vnode_if.awk",
    outs = ["vnode_if.c", "vnode_if.h", "vnode_if_newproto.h", "vnode_if_typedef.h"],
    modes = {"vnode_if.c": "-c", "vnode_if.h": "-h",
             "vnode_if_newproto.h": "-p", "vnode_if_typedef.h": "-q"},
)

# vnode_if.h, the -h pass of the same script.

