# acpi_wakecode.bin/.h/wakedata.h, as sys/conf/files.amd64's before-depend
# rules chain them off the acpi_wakecode.o of cc_002.
genrule(
    name = "acpi_wakecode",
    srcs = [":cc_062"],
    outs = [
        "acpi_wakecode.bin",
        "acpi_wakecode.h",
        "acpi_wakedata.h",
    ],
    cmd = """
        A=$$PWD/$(location :cc_062)
        OC=$$PWD/$(location @kernel_llvm//:bin/llvm-objcopy)
        NM=$$PWD/$(location @kernel_llvm//:bin/llvm-nm)
        F2C=$$PWD/$(location //usr.bin/file2c:file2c)
        OUT=$$PWD/$(RULEDIR)
        mkdir t && cd t
        ar p "$$A" acpi_wakecode.o > acpi_wakecode.o
        "$$OC" -S -O binary acpi_wakecode.o acpi_wakecode.bin
        "$$NM" -n --defined-only acpi_wakecode.o |
            while read offset dummy what; do
                printf '#define\t%s\t0x%s\n' "$$what" "$$offset"
            done > acpi_wakedata.h
        "$$F2C" -sx 'static char wakecode[] = {' '};' < acpi_wakecode.bin > acpi_wakecode.h
        mv acpi_wakecode.bin acpi_wakecode.h acpi_wakedata.h "$$OUT/"
        cd .. && rm -rf t
    """,
    tools = [
        "//usr.bin/file2c:file2c",
        "@kernel_llvm//:bin/llvm-objcopy",
        "@kernel_llvm//:bin/llvm-nm",
    ],
)

# vers.c + version, as kern.post.mk's newvers rule runs newvers.sh (-R: no
# metadata). The tree's COPYRIGHT (staged) fixes the year; the make -V
# queries KERN_IDENT/CC the Makefile answers are answered by a shim, whose
# CC is the toolchain's clang (newvers.sh runs "$CC -v" for its
# compiler_version line).
genrule(
    name = "newvers",
    srcs = [
        "//:sys/conf/newvers.sh",
        "//:sys/sys/param.h",
        "//:COPYRIGHT",
    ],
    outs = [
        "vers.c",
        "version",
    ],
    cmd = """
        NV=$$PWD/$(location //:sys/conf/newvers.sh)
        CC=$$PWD/$(location @kernel_llvm//:bin/clang)
        OUT=$$PWD/$(RULEDIR)
        mkdir t && cd t
        printf '#!/bin/sh\ncase "$$1 $$2" in\n"-V CC") echo "$$CCCMD";;\n"-V KERN_IDENT") echo BZL;;\n*) exit 1;;\nesac\n' > mk
        chmod +x mk
        MAKE=$$PWD/mk CCCMD="$$CC" sh "$$NV" -R -d /usr/obj/usr/src/amd64.amd64/sys/BZL BZL
        mv vers.c version "$$OUT/"
        cd .. && rm -rf t
    """,
    tools = ["@kernel_llvm//:bin/clang"],
)

# The vdso images, as sys/tools/amd64_vdso.sh / amd64_ia32_vdso.sh build
# them in the compile directory: a staged tree (opt_global.h and the
# machine/x86/i386 include symlinks) plus S=sys. ELFDUMP is left unset --
# there is no elfdump in the sandbox, exactly as in the reference build,
# where its RELOCS check is what fails silently.
genrule(
    name = "vdso",
    srcs = [
        ":assym_inc",
        ":config",
        "//:amd64_include",
        "//:sys_headers",
        "//:sys/tools/amd64_vdso.sh",
        "//:sys/amd64/amd64/sigtramp.S",
        "//:sys/tools/vdso_wrap.S",
        "//:sys/conf/vdso_amd64.ldscript",
    ],
    outs = [
        "sigtramp.pico",
        "elf-vdso.so.o",
        "elf-vdso.so.1",
        "vdso_offsets.h",
    ],
    cmd = """
        CCB=$$PWD/$(location @kernel_llvm//:bin/clang)
        LDB=$$PWD/$(location @kernel_llvm//:bin/ld.lld)
        NMB=$$PWD/$(location @kernel_llvm//:bin/llvm-nm)
        AWKB=$$PWD/$(location //usr.bin/awk:awk)
        SHF=$$PWD/$(location //:sys/tools/amd64_vdso.sh)
        SYS=$$PWD/sys
        G=$$PWD/$(GENDIR)/sys/BZL
        OUT=$$PWD/$(RULEDIR)
        mkdir t && cd t
        cp "$$G/opt_global.h" .
        cp "$$G/assym.inc" .
        ln -s "$$SYS/amd64/include" machine
        ln -s "$$SYS/x86/include" x86
        ln -s "$$SYS/i386/include" i386
        CC="$$CCB -target x86_64-unknown-freebsd15.1 -B$$(dirname $$CCB)" \
            LD="$$LDB" AWK="$$AWKB" NM="$$NMB" ELFDUMP=elfdump S="$$SYS" \
            sh "$$SHF"
        mv sigtramp.pico elf-vdso.so.o elf-vdso.so.1 vdso_offsets.h "$$OUT/"
        cd .. && rm -rf t
    """,
    tools = [
        "@kernel_llvm//:bin/clang",
        "@kernel_llvm//:bin/ld.lld",
        "@kernel_llvm//:bin/llvm-nm",
        "//usr.bin/awk:awk",
    ],
)

