        "opt_wpi.h",
        "opt_x86bios.h",
        "opt_xbonehack.h",
        "opt_xdr.h",
        "opt_zstdio.h",
    ],
    # config(8) is driven the way the reference drove it: from a directory
    # that looks like a kernel conf dir -- config opens "DEFAULTS" relative
    # to the cwd (that is where "machine amd64" comes from), and reads the
    # machine skeleton and file/option tables as "../../conf/...". The
    # sandbox stages that shape as a pair of symlinks into the declared
    # inputs, then runs the config on the BZL file.
    cmd = """
        CFG=$$PWD/$(location //usr.sbin/config:config)
        BZL=$$PWD/$(location //:sys/amd64/conf/BZL)
        OUT=$$PWD/$(RULEDIR)
        W=$$PWD/w
        mkdir -p w/sys/amd64 w/sys
        ln -s ../../../sys/amd64/conf w/sys/amd64/conf
        ln -s ../../sys/conf w/sys/conf
        cd w/sys/amd64/conf
        "$$CFG" -d "$$OUT/_cfg" -I "$$PWD" "$$BZL"
        cp "$$OUT/_cfg"/config.c "$$OUT/_cfg"/env.c "$$OUT/_cfg"/hints.c \
           "$$OUT/_cfg"/opt_*.h "$$OUT/"
        cd "$$OUT" && rm -rf _cfg "$$W"
    """,
    tools = ["//usr.sbin/config:config"],
)


