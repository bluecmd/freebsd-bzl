    hdr = "acpi_wakecode.h",
    data = "acpi_wakedata.h",
)

# vers.c + version, as kern.post.mk's newvers rule runs newvers.sh (-R: no
# metadata). The tree's COPYRIGHT (staged) fixes the year; the make -V
# queries KERN_IDENT/CC the Makefile answers are answered by a shim, whose
# CC is the toolchain's clang (newvers.sh runs "$CC -v" for its
# compiler_version line).
newvers(
    name = "newvers",
    script = "//:sys/conf/newvers.sh",
    copyright = "//:COPYRIGHT",
    sources = ["//:sys/sys/param.h"],
    vers = "vers.c",
    version = "version",
)

# The vdso images, as sys/tools/amd64_vdso.sh / amd64_ia32_vdso.sh build
# them in the compile directory: a staged tree (opt_global.h and the
# machine/x86/i386 include symlinks) plus S=sys. ELFDUMP is left unset --
# there is no elfdump in the sandbox, exactly as in the reference build,
# where its RELOCS check is what fails silently.
vdso_image(
    name = "vdso",
    script = "//:sys/tools/amd64_vdso.sh",
    opt_global = ":opt_global.h",
    assym = ":assym.inc",
    includes = ["//:amd64_include", "//:sys_headers"],
    sources = [
        "//sys/amd64/amd64:sigtramp.S",
        "//:sys/tools/vdso_wrap.S",
        "//:sys/conf/vdso_amd64.ldscript",
    ],
    outs = ["sigtramp.pico", "elf-vdso.so.o", "elf-vdso.so.1", "vdso_offsets.h"],
)

vdso_image(
    name = "vdso_ia32",
    script = "//:sys/tools/amd64_ia32_vdso.sh",
    opt_global = ":opt_global.h",
    assym = ":ia32_assym.h",
    includes = ["//:amd64_include", "//:x86_include", "//:i386_include", "//:sys_headers"],
    sources = [
        "//sys/amd64/ia32:ia32_sigtramp.S",
        "//:sys/tools/vdso_wrap.S",
        "//:sys/conf/vdso_amd64_ia32.ldscript",
    ],
    i386 = True,
    outs = ["ia32_sigtramp.pico", "elf-vdso32.so.o", "elf-vdso32.so.1", "vdso_ia32_offsets.h"],
)

# The rpctlscd/rpctlssd rpcgen outputs, as kern.pre.mk's RPCGEN rules run
# them (rpcgen preprocesses through $CPP; the reference's cpp is the
# toolchain's clang-cpp).
rpcgen_xdr(
    name = "rpctlscd_gen",
    x = "//sys/rpc/rpcsec_tls:rpctlscd.x",
    flags = {"rpctlscd.h": "-hM", "rpctlscd_xdr.c": "-c", "rpctlscd_clnt.c": "-lM"},
    grep = {"rpctlscd.h": "pthread.h", "rpctlscd_clnt.c": "string.h"},
    outs = ["rpctlscd.h", "rpctlscd_xdr.c", "rpctlscd_clnt.c"],
)

rpcgen_xdr(
    name = "rpctlssd_gen",
    x = "//sys/rpc/rpcsec_tls:rpctlssd.x",
    flags = {"rpctlssd.h": "-hM", "rpctlssd_xdr.c": "-c", "rpctlssd_clnt.c": "-lM"},
    grep = {"rpctlssd.h": "pthread.h", "rpctlssd_clnt.c": "string.h"},
    outs = ["rpctlssd.h", "rpctlssd_xdr.c", "rpctlssd_clnt.c"],
)

# The BFD dynamic-mode hack: an empty translation unit (kern.post.mk's
# ":> ${.TARGET}"), compiled with the kernel's line and linked -shared so
# the kernel link stays in dynamic mode.
genrule(
    name = "force-dynamic-hack.c",
    outs = ["force-dynamic-hack.c"],
    cmd = ": > '$(location :force-dynamic-hack.c)'",
)

load("//bazel/rules:freebsd_kernel_link.bzl", "freebsd_kernel_link")

# The BFD dynamic-mode hack, as the reference builds it: the empty TU compiled
# with the kernel's line (force_dynamic_hack), then the driver links it -shared into the
# .pico (kern.post.mk's .pico rule: the kernel's compile flags ride the link
# line; -MD/-MF/-MT track bmake's .depend side file, which has no artifact
# here). The objcopy endgame does not run -- out/debug_out unset.
freebsd_kernel_link(
    name = "force-dynamic-hack",
    out = "force-dynamic-hack.pico",
    driver = "@kernel_llvm//:bin/clang",
    args = [
        "-target",
        "x86_64-unknown-freebsd15.1",
        "--ld-path=$(location @kernel_llvm//:bin/ld.lld)",
        "-shared",
        "-O2",
        "-pipe",
        "-fno-strict-aliasing",
        "-g",
        "-nostdinc",
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-D_KERNEL",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-fno-common",
        "-fno-omit-frame-pointer",
        "-mno-omit-leaf-frame-pointer",
        "-ffile-prefix-map=$(GENDIR)/sys/BZL=/usr/obj/usr/src/amd64.amd64/sys/BZL",
        "-mcmodel=kernel",
        "-mno-red-zone",
        "-mno-mmx",
        "-mno-sse",
        "-msoft-float",
        "-fno-asynchronous-unwind-tables",
        "-ffreestanding",
        "-fwrapv",
        "-fstack-protector",
        "-gdwarf-4",
        "-Wall",
        "-Wstrict-prototypes",
        "-Wmissing-prototypes",
        "-Wpointer-arith",
        "-Wcast-qual",
        "-Wundef",
        "-Wno-pointer-sign",
        "-D__printf__=__freebsd_kprintf__",
        "-Wmissing-include-dirs",
        "-fdiagnostics-show-option",
        "-Wno-unknown-pragmas",
        "-Wswitch",
        "-Wno-error=tautological-compare",
        "-Wno-error=empty-body",
        "-Wno-error=parentheses-equality",
        "-Wno-error=unused-function",
        "-Wno-error=pointer-sign",
        "-Wno-error=shift-negative-value",
        "-Wno-address-of-packed-member",
        "-Wno-format-zero-length",
        "-mno-aes",
        "-mno-avx",
        "-std=gnu17",
        "-nostdlib",
    ],
    srcs = [
        "@kernel_llvm//:bin/ld.lld",
        "//:sys_headers",
    ],
    deps = [":force_dynamic_hack"],
)

cc_per_source_library(
    name = "genoffset",
    features = ["kernel_compile_flags"],
    copts = [
        "-fcommon"
    ],
    srcs = [
    "//sys/kern:genoffset.c",
    ],
    hdrs = [
        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
# The genassym objects: their compiles read offset.inc (kpilite.h pulls it in
# whenever GENOFFSET is undefined), so they sit behind the offset generator.
cc_per_source_library(
    name = "genassym",
    features = ["kernel_compile_flags"],
    copts = [
        "-fcommon"
    ],
    srcs = [
    "//sys/amd64/amd64:genassym.c",
    "//sys/compat/ia32:ia32_genassym.c",
    ],
    hdrs = [
        ":offset_inc",
        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
# acpi_wakecode.o is a tool object, not a kernel object: the reference
# compiles it for the wakecode chain only, so its own target keeps it out of
# the link's loose objects.
cc_per_source_library(
    name = "acpi_wakecode_s",
    features = ["kernel_compile_flags"],
    copts = [
        "-x",
        "assembler-with-cpp",
        "-DLOCORE",
        "-Werror"
    ],
    srcs = [
    "//sys/amd64/acpica:acpi_wakecode.S",
    ],
    hdrs = [
        ":assym_inc",
        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
cc_per_source_library(
    name = "card_if_c",
    features = ["kernel_compile_flags"],
    copts = [
        "-Werror"
    ],
