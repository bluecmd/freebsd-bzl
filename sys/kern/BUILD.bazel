# The kernel's compile groups for sys/kern (run 2026-10-09: one package
# per kernel source directory; the reference's link-line object
# order is carried by the kernel link's deps list).
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*"], allow_empty = True))

# The directory's headers, for the kernel's -Isys include
# surface: root kernel_headers / sys_headers take this carrier
# across the package boundary (their glob stops here).
filegroup(
    name = "headers",
    srcs = glob(["**/*.h", "**/*.inc"], allow_empty = True),
)

cc_per_source_library(
    name = "cc_001",
    features = ["kernel_compile_flags"],
    copts = [
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-fcommon",
        "-DOFFSET_TEST"
    ],
    srcs = [
        "genoffset.c",
    ],
    hdrs = [
        "//sys/BZL:offset_inc",
        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
cc_per_source_library(
    name = "cc_002",
    features = ["kernel_compile_flags"],
    copts = [
        "-x",
        "assembler-with-cpp",
        "-DLOCORE",
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror"
    ],
    srcs = [
        "subr_ticks.S",
    ],
    hdrs = [
        "//sys/amd64/ia32:ia32_exception.S",
        "//sys/amd64/amd64:apic_vector.S",
        "//sys/amd64/amd64:atpic_vector.S",
        "//sys/BZL:assym_inc",
        "//sys/BZL:ia32_assym",

        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
