# The kernel's compile groups for sys/amd64/include (run 2026-10-09: one package
# per kernel source directory; the reference's link-line object
# order is carried by the kernel link's deps list).
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The build links `sys/BZL/machine` -> `sys/amd64/include`: `<machine/...>` names these headers.
cc_library(
    name = "machine_include",
    hdrs = glob(["**"], allow_empty = True),
    include_prefix = "machine",
)

# The tree as files: the step rules that stage a compile directory stage it under `machine/`.
filegroup(
    name = "tree",
    srcs = glob(["**"], allow_empty = True),
)
