# The kernel's compile groups for sys/amd64/amd64 (run 2026-10-09: one package
# per kernel source directory; the reference's link-line object
# order is carried by the kernel link's deps list).
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*"], allow_empty = True))

# The directory's headers, for the kernel's -Isys include
# surface: root kernel_headers / sys_headers take this carrier
# across the package boundary (their glob stops here).
filegroup(
    name = "headers",
    srcs = glob(["**/*.h", "**/*.inc"], allow_empty = True),
)

cc_per_source_library(
    name = "cc_002",
    features = ["kernel_compile_flags"],
    copts = [
        "-x",
        "assembler-with-cpp",
        "-DLOCORE",
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror"
    ],
    srcs = [
        "cpu_switch.S",
        "efirt_support.S",
        "exception.S",
        "locore.S",
        "mpboot.S",
        "support.S",
    ],
    hdrs = [
        "//sys/amd64/ia32:ia32_exception.S",
        "apic_vector.S",
        "atpic_vector.S",
        "//sys/BZL:assym_inc",
        "//sys/BZL:ia32_assym",

        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
cc_per_source_library(
    name = "cc_003",
    features = ["kernel_compile_flags"],
    copts = [
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror"
    ],
    srcs = [
        "bios.c",
        "copyout.c",
        "db_disasm.c",
        "db_interface.c",
        "db_trace.c",
        "efirt_machdep.c",
        "elf_machdep.c",
        "exec_machdep.c",
        "fpu.c",
        "gdb_machdep.c",
        "initcpu.c",
        "io.c",
        "machdep.c",
        "mem.c",
        "minidump_machdep.c",
        "mp_machdep.c",
        "pmap.c",
        "ptrace_machdep.c",
        "sys_machdep.c",
        "trap.c",
        "uio_machdep.c",
        "vm_machdep.c",
    ],
    hdrs = [
        "//sys/BZL:offset_inc",
        "//sys/BZL:vdso",
        "//sys/BZL:vdso_ia32",
        "//sys/BZL:acpi_wakecode",

        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    additional_compiler_inputs = [
        "//sys/kern:imgact_elf.c",
        "//sys/kern:kern_ctf.c",
        "//sys/libkern:qsort.c",
        "//sys/kern:subr_busdma_bounce.c",
        "//sys/kern:subr_syscall.c",
        "//sys/dev/xen/netback:netback_unit_tests.c",
        "//sys/crypto/chacha20:chacha.c",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
cc_per_source_library(
    name = "cc_050",
    features = ["kernel_compile_flags"],
    copts = [
        "-x",
        "assembler-with-cpp",
        "-DLOCORE",
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror",
        "-g0"
    ],
    srcs = [
        "xen-locore.S",
    ],
    hdrs = [
        "//sys/BZL:assym_inc",
        "//sys/BZL:offset_inc",
        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
