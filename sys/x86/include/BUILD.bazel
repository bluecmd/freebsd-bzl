# The kernel's compile groups for sys/x86/include (run 2026-10-09: one package
# per kernel source directory; the reference's link-line object
# order is carried by the kernel link's deps list).
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The tree as files: the step rules that stage a compile directory stage it under `x86/`.
filegroup(
    name = "tree",
    srcs = glob(["**"], allow_empty = True),
)

# The build links `sys/BZL/x86` -> `sys/x86/include`: `<x86/...>` names these headers.
cc_library(
    name = "x86_include",
    hdrs = glob(["**"], allow_empty = True),
    include_prefix = "x86",
)
