# The kernel's compile groups for sys/libkern (run 2026-10-09: one package
# per kernel source directory; the reference's link-line object
# order is carried by the kernel link's deps list).
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*"], allow_empty = True))

# The directory's headers, for the kernel's -Isys include
# surface: root kernel_headers / sys_headers take this carrier
# across the package boundary (their glob stops here).
filegroup(
    name = "headers",
    srcs = glob(["**/*.h", "**/*.inc"], allow_empty = True),
)

cc_per_source_library(
    name = "cc_003",
    features = ["kernel_compile_flags"],
    copts = [
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror"
    ],
    srcs = [
        "arc4random.c",
        "arc4random_uniform.c",
        "asprintf.c",
        "bcd.c",
        "bsearch.c",
        "crc16.c",
        "explicit_bzero.c",
        "fnmatch.c",
        "gsb_crc32.c",
        "inet_aton.c",
        "inet_ntoa.c",
        "inet_ntop.c",
        "inet_pton.c",
        "jenkins_hash.c",
        "memcchr.c",
        "memchr.c",
        "memmem.c",
        "murmur3_32.c",
        "qsort.c",
        "qsort_r.c",
        "random.c",
        "scanc.c",
        "strcasecmp.c",
        "strcasestr.c",
        "strcat.c",
        "strchr.c",
        "strchrnul.c",
        "strcmp.c",
        "strcpy.c",
        "strcspn.c",
        "strdup.c",
        "strlcat.c",
        "strlcpy.c",
        "strncat.c",
        "strncmp.c",
        "strncpy.c",
        "strndup.c",
        "strnlen.c",
        "strnstr.c",
        "strrchr.c",
        "strsep.c",
        "strspn.c",
        "strstr.c",
        "strtol.c",
        "strtoq.c",
        "strtoul.c",
        "strtouq.c",
        "strvalid.c",
        "timingsafe_bcmp.c",
    ],
    hdrs = [
        "//sys/BZL:offset_inc",
        "//sys/BZL:vdso",
        "//sys/BZL:vdso_ia32",
        "//sys/BZL:acpi_wakecode",

        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    additional_compiler_inputs = [
        "//sys/kern:imgact_elf.c",
        "//sys/kern:kern_ctf.c",
        "qsort.c",
        "//sys/kern:subr_busdma_bounce.c",
        "//sys/kern:subr_syscall.c",
        "//sys/dev/xen/netback:netback_unit_tests.c",
        "//sys/crypto/chacha20:chacha.c",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
