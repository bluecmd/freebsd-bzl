# The kernel's compile groups for sys/netinet (run 2026-10-09: one package
# per kernel source directory; the reference's link-line object
# order is carried by the kernel link's deps list).
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*"], allow_empty = True))

# The directory's headers, for the kernel's -Isys include
# surface: root kernel_headers / sys_headers take this carrier
# across the package boundary (their glob stops here).
filegroup(
    name = "headers",
    srcs = glob(["**/*.h", "**/*.inc"], allow_empty = True),
)

cc_per_source_library(
    name = "cc_003",
    features = ["kernel_compile_flags"],
    copts = [
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror"
    ],
    srcs = [
        "if_ether.c",
        "igmp.c",
        "in.c",
        "in_cksum.c",
        "in_debug.c",
        "in_fib.c",
        "in_fib_algo.c",
        "in_gif.c",
        "in_jail.c",
        "in_kdtrace.c",
        "in_mcast.c",
        "in_pcb.c",
        "in_prot.c",
        "in_proto.c",
        "in_rmx.c",
        "ip_ecn.c",
        "ip_encap.c",
        "ip_fastfwd.c",
        "ip_icmp.c",
        "ip_id.c",
        "ip_input.c",
        "ip_options.c",
        "ip_output.c",
        "ip_reass.c",
    ],
    hdrs = [
        "//sys/BZL:offset_inc",
        "//sys/BZL:vdso",
        "//sys/BZL:vdso_ia32",
        "//sys/BZL:acpi_wakecode",

        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    additional_compiler_inputs = [
        "//sys/kern:imgact_elf.c",
        "//sys/kern:kern_ctf.c",
        "//sys/libkern:qsort.c",
        "//sys/kern:subr_busdma_bounce.c",
        "//sys/kern:subr_syscall.c",
        "//sys/dev/xen/netback:netback_unit_tests.c",
        "//sys/crypto/chacha20:chacha.c",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
cc_per_source_library(
    name = "cc_003_2",
    features = ["kernel_compile_flags"],
    copts = [
        "-I$(GENDIR)/sys/BZL",
        "-Isys",
        "-Isys/contrib/ck/include",
        "-Isys/contrib/libfdt",
        "-DHAVE_KERNEL_OPTION_HEADERS",
        "-include",
        "$(GENDIR)/sys/BZL/opt_global.h",
        "-Werror"
    ],
    srcs = [
        "raw_ip.c",
        "sctp_crc32.c",
        "tcp_ecn.c",
        "tcp_fastopen.c",
        "tcp_hostcache.c",
        "tcp_input.c",
        "tcp_log_buf.c",
        "tcp_lro.c",
        "tcp_offload.c",
        "tcp_output.c",
        "tcp_reass.c",
        "tcp_sack.c",
        "tcp_subr.c",
        "tcp_syncache.c",
        "tcp_timer.c",
        "tcp_timewait.c",
        "tcp_usrreq.c",
        "udp_usrreq.c",
    ],
    hdrs = [
        "//sys/BZL:offset_inc",
        "//sys/BZL:vdso",
        "//sys/BZL:vdso_ia32",
        "//sys/BZL:acpi_wakecode",

        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    additional_compiler_inputs = [
        "//sys/kern:imgact_elf.c",
        "//sys/kern:kern_ctf.c",
        "//sys/libkern:qsort.c",
        "//sys/kern:subr_busdma_bounce.c",
        "//sys/kern:subr_syscall.c",
        "//sys/dev/xen/netback:netback_unit_tests.c",
        "//sys/crypto/chacha20:chacha.c",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
