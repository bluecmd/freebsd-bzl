# The kernel's compile groups for sys/dev/xz (run 2026-10-09: one package
# per kernel source directory; the reference's link-line object
# order is carried by the kernel link's deps list).
load("//bazel/rules:cc_per_source_library.bzl", "cc_per_source_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*"], allow_empty = True))

cc_per_source_library(
    name = "xz_mod",
    features = ["kernel_compile_flags"],
    copts = [
        "-Werror",
        "-DXZ_USE_CRC64",
        "-Isys/contrib/xz-embedded/freebsd/",
        "-Isys/contrib/xz-embedded/linux/lib/xz/",
        "-Isys/contrib/xz-embedded/linux/include/linux/"
    ],
    srcs = [
        "xz_mod.c",
    ],
    hdrs = [
        "//sys/BZL:offset_inc",
        "//sys/BZL:config",
        "//sys/BZL:generated",
    ],
    deps = [
        "//:kernel_headers",
    ],
)
