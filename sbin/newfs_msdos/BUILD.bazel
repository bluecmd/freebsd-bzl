load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# mkfs_msdos, the FAT formatter makefs(8) borrows from sbin/newfs_msdos (the
# reference's obj-tools makefs build compiles the same file; the kernel-tree
# -I roots it needs -- sys/fs/msdosfs, sbin/newfs_msdos -- come from
# makefs_includes, the makefs root from //usr.sbin/makefs:headers).
cc_library(
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    name = "mkfs_msdos",
    srcs = ["mkfs_msdos.c"],
    hdrs = ["mkfs_msdos.h"],
    defines = [
        "MAKEFS",
        "HAVE_ZFS",
        "_WANT_MSDOSFS_INTERNALS",
        "HAVE_STRUCT_STAT_ST_FLAGS=1",
    ],
    deps = [
        "//usr.sbin/makefs:headers",
        "//:makefs_includes",
        "//lib/libc:legacy",
        "//lib/libnetbsd:netbsd",
        "//lib/libsbuf:sbuf",
        "//tools/build/cross-build:progname",
        "//tools/build/cross-build:bitcount",
        "//tools/build/cross-build:nbtool",
    ],
)

exports_files([
    "mkfs_msdos.c",
    "mkfs_msdos.h",
])
