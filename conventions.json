{
  "//": "any2bazel emit_build.py conventions for the freebsd-bzl workspace: the FreeBSD tree is the Bazel workspace (project root .), the kernel compiles with the pinned kernel_llvm toolchain through the layer's own rules (cc_per_source_library, freebsd_kernel_link, kernel_steps), host tools with the hermetic LLVM exec toolchain. This file is the record of the derivation facts the emitter consumes; the delivered BUILD files were refined beyond the emit render (a re-emit does not reproduce them byte-for-byte -- see the run reports), so run the emitter in a scratch copy, never over the layer.",
  "bootstrap": [
    {
      "attrs": {
        "copts": [
          "-fcommon"
        ],
        "deps": [
          "//:kernel_headers"
        ],
        "features": [
          "kernel_compile_flags"
        ],
        "hdrs": [
          "//sys/BZL:config",
          "//sys/BZL:generated"
        ],
        "srcs": [
          "//sys/kern:genoffset.c"
        ]
      },
      "claims": [
        "sys/BZL/genoffset.o"
      ],
      "comment": [
        "the `genoffset` tool object: the reference compiles it inside",
        "the buildkernel replay, below exec capture's resolution; its",
        "compile is not in the model. The include surface is the",
        "layer's (converged text) and remains the include-surface item."
      ],
      "load": "//bazel/rules:cc_per_source_library.bzl",
      "name": "genoffset",
      "pkg": "sys/BZL",
      "rule": "cc_per_source_library"
    },
    {
      "attrs": {
        "copts": [
          "-fcommon"
        ],
        "deps": [
          "//:kernel_headers"
        ],
        "features": [
          "kernel_compile_flags"
        ],
        "hdrs": [
          ":offset_inc",
          "//sys/BZL:config",
          "//sys/BZL:generated"
        ],
        "srcs": [
          "//sys/amd64/amd64:genassym.c",
          "//sys/compat/ia32:ia32_genassym.c"
        ]
      },
      "claims": [
        "sys/BZL/genassym.o",
        "sys/BZL/ia32_genassym.o"
      ],
      "comment": [
        "the `genassym` tool object: the reference compiles it inside",
        "the buildkernel replay, below exec capture's resolution; its",
        "compile is not in the model. The include surface is the",
        "layer's (converged text) and remains the include-surface item."
      ],
      "load": "//bazel/rules:cc_per_source_library.bzl",
      "name": "genassym",
      "pkg": "sys/BZL",
      "rule": "cc_per_source_library"
    },
    {
      "attrs": {
        "copts": [
          "-x",
          "assembler-with-cpp",
          "-DLOCORE",
          "-Werror"
        ],
        "deps": [
          "//:kernel_headers"
        ],
        "features": [
          "kernel_compile_flags"
        ],
        "hdrs": [
          ":assym_inc",
          "//sys/BZL:config",
          "//sys/BZL:generated"
        ],
        "srcs": [
          "//sys/amd64/acpica:acpi_wakecode.S"
        ]
      },
      "claims": [
        "sys/BZL/acpi_wakecode.o"
      ],
      "comment": [
        "the `acpi_wakecode_s` tool object: the reference compiles it inside",
        "the buildkernel replay, below exec capture's resolution; its",
        "compile is not in the model. The include surface is the",
        "layer's (converged text) and remains the include-surface item."
      ],
      "load": "//bazel/rules:cc_per_source_library.bzl",
      "name": "acpi_wakecode_s",
      "pkg": "sys/BZL",
      "rule": "cc_per_source_library"
    },
    {
      "attrs": {
        "copts": [
          "-fcommon",
          "-DOFFSET_TEST"
        ],
        "deps": [
          "//:kernel_headers"
        ],
        "features": [
          "kernel_compile_flags"
        ],
        "hdrs": [
          "//sys/BZL:offset_inc",
          "//sys/BZL:config",
          "//sys/BZL:generated"
        ],
        "srcs": [
          "//sys/kern:genoffset.c"
        ]
      },
      "claims": [
        "sys/BZL/genoffset_test.o"
      ],
      "comment": [
        "the -DOFFSET_TEST genoffset compile: the reference builds the",
        "tool's object twice (kern.post.mk: genoffset.o for the",
        "generator, genoffset_test.o for the offset test); the plain",
        "one is sys/BZL:genoffset above."
      ],
      "load": "//bazel/rules:cc_per_source_library.bzl",
      "name": "genoffset",
      "pkg": "sys/kern",
      "rule": "cc_per_source_library"
    }
  ],
  "builtin_include": {
    "copts": [
      "-isystem",
      "external/+kernel_llvm_toolchain+kernel_llvm/resource_include"
    ],
    "dep": "@kernel_llvm//:clang_builtins",
    "srcs": [
      "sys/crypto/aesni/aesni_ccm.c",
      "sys/crypto/aesni/aesni_ghash.c",
      "sys/crypto/aesni/aesni_wrap.c",
      "sys/crypto/aesni/intel_sha1.c",
      "sys/crypto/aesni/intel_sha256.c"
    ]
  },
  "config_template": {
    "bazel_args": [
      "--config=kernel"
    ],
    "codegen": {
      "content_ignore_lines": [
        "^ \\*   .+\\.m$",
        "^#define SCCSSTR \".*$",
        "^#define VERSTR \".*$"
      ],
      "mnemonics": [
        "Genrule",
        "TemplateExpand",
        "FileWrite",
        "CopyFile",
        "Symlink",
        "Flex",
        "Bison",
        "M4",
        "ProtoCompile",
        "GenProto",
        "GenProtoDescriptorSet",
        "RunBinary",
        "AwkGenerate",
        "YaccGenerate",
        "LexGenerate",
        "GenOffsets",
        "RpcgenGenerate",
        "NewversGenerate",
        "VdsoGenerate",
        "AcpiWakecode",
        "KernelConfig"
      ],
      "tool_map": {
        "awk": "//usr.bin/awk:awk",
        "sys/conf/newvers.sh": "$(pwd)/sys/conf/newvers.sh",
        "sys/tools/amd64_ia32_vdso.sh": "$SCRIPT",
        "sys/tools/amd64_vdso.sh": "$SCRIPT"
      }
    }
  },
  "drop_copts_prefixes": [
    "--sysroot=",
    "-B",
    "-fdebug-prefix-map=",
    "-fmacro-prefix-map=",
    "-ffile-prefix-map="
  ],
  "generated_header_includes": {
    "sys/BZL/vnode_if.h": [
      "sys/BZL/vnode_if_typedef.h",
      "sys/BZL/vnode_if_newproto.h"
    ]
  },
  "group_name_map": {
    "sys/contrib/ck/src:ck_array.c": "ck",
    "sys/contrib/libb2:blake2b-ref.c": "blake2_ref"
  },
  "include_surface": {
    "aggregate": "kernel_headers",
    "aggregates": [
      {
        "globs": [
          "sys/**/*.h"
        ],
        "name": "sys_headers"
      }
    ],
    "carriers": [
      {
        "link": "machine",
        "name": "machine_include",
        "pkg": "sys/amd64/include",
        "root_label": "amd64_include",
        "tree": "tree"
      },
      {
        "link": "x86",
        "name": "x86_include",
        "pkg": "sys/x86/include",
        "root_label": "x86_include",
        "tree": "tree"
      },
      {
        "link": "i386",
        "name": "i386_include",
        "pkg": "sys/i386/include",
        "root_label": "i386_include",
        "tree": "tree"
      }
    ],
    "exports_files": {
      "per_package": "**/*",
      "root": [
        "sys/**/*",
        "COPYRIGHT",
        "tools/build/libc-bootstrap/**",
        "include/*.h"
      ]
    },
    "groups": [
      {
        "globs": [
          "sys/conf/**",
          "sys/amd64/conf/**"
        ],
        "name": "config_inputs"
      }
    ],
    "includes": [
      "sys"
    ],
    "package_headers": {
      "globs": [
        "**/*.h",
        "**/*.inc"
      ],
      "name": "headers"
    },
    "step_outputs": {
      "exclude": [
        "force-dynamic-hack.c"
      ],
      "name": "generated",
      "pkg": "sys/BZL"
    }
  },
  "link_rule": {
    "targets": {
      "force-dynamic-hack": {
        "attrs": {
          "args": [
            "-target",
            "x86_64-unknown-freebsd15.1",
            "--ld-path=$(location @kernel_llvm//:bin/ld.lld)",
            "-shared",
            "-O2",
            "-pipe",
            "-fno-strict-aliasing",
            "-g",
            "-nostdinc",
            "-I$(GENDIR)/sys/BZL",
            "-Isys",
            "-Isys/contrib/ck/include",
            "-Isys/contrib/libfdt",
            "-D_KERNEL",
            "-DHAVE_KERNEL_OPTION_HEADERS",
            "-include",
            "$(GENDIR)/sys/BZL/opt_global.h",
            "-fno-common",
            "-fno-omit-frame-pointer",
            "-mno-omit-leaf-frame-pointer",
            "-ffile-prefix-map=$(GENDIR)/sys/BZL=/usr/obj/usr/src/amd64.amd64/sys/BZL",
            "-mcmodel=kernel",
            "-mno-red-zone",
            "-mno-mmx",
            "-mno-sse",
            "-msoft-float",
            "-fno-asynchronous-unwind-tables",
            "-ffreestanding",
            "-fwrapv",
            "-fstack-protector",
            "-gdwarf-4",
            "-Wall",
            "-Wstrict-prototypes",
            "-Wmissing-prototypes",
            "-Wpointer-arith",
            "-Wcast-qual",
            "-Wundef",
            "-Wno-pointer-sign",
            "-D__printf__=__freebsd_kprintf__",
            "-Wmissing-include-dirs",
            "-fdiagnostics-show-option",
            "-Wno-unknown-pragmas",
            "-Wswitch",
            "-Wno-error=tautological-compare",
            "-Wno-error=empty-body",
            "-Wno-error=parentheses-equality",
            "-Wno-error=unused-function",
            "-Wno-error=pointer-sign",
            "-Wno-error=shift-negative-value",
            "-Wno-address-of-packed-member",
            "-Wno-format-zero-length",
            "-mno-aes",
            "-mno-avx",
            "-std=gnu17",
            "-nostdlib"
          ],
          "driver": "@kernel_llvm//:bin/clang",
          "out": "force-dynamic-hack.pico",
          "srcs": [
            "@kernel_llvm//:bin/ld.lld",
            "//:sys_headers"
          ]
        },
        "load": "//bazel/rules:freebsd_kernel_link.bzl",
        "name": "force-dynamic-hack",
        "pkg": "sys/BZL",
        "rule": "freebsd_kernel_link"
      },
      "kernel.full": {
        "attrs": {
          "args": [
            "-m",
            "elf_x86_64_fbsd",
            "-Bdynamic",
            "-L",
            "sys/conf",
            "-T",
            "$(location //:sys/conf/ldscript.amd64)",
            "--build-id=sha1",
            "-z",
            "max-page-size=2097152",
            "-z",
            "notext",
            "-z",
            "ifunc-noplt",
            "--no-warn-mismatch",
            "--warn-common",
            "--export-dynamic",
            "--dynamic-linker",
            "/red/herring",
            "-X"
          ],
          "debug_out": "kernel.debug",
          "object_files": {
            ":vdso": "elf-vdso.so.o",
            ":vdso_ia32": "elf-vdso32.so.o"
          },
          "out": "kernel.full",
          "shared_libs": [
            ":force-dynamic-hack"
          ],
          "srcs": [
            "//:sys/conf/ldscript.amd64",
            "//:sys/conf/debuginfo.ldscript"
          ],
          "stripped_out": "kernel"
        },
        "load": "//bazel/rules:freebsd_kernel_link.bzl",
        "name": "kernel",
        "pkg": "sys/BZL",
        "rule": "freebsd_kernel_link"
      }
    }
  },
