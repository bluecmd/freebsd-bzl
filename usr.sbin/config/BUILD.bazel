load("//bazel/rules:yacc_lex.bzl", "lex_generate", "yacc_generate")
package(default_visibility = ["//visibility:public"])
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
# config(8), as usr.sbin/config/Makefile builds it: yacc over config.y
# (renamed to config.c as bsd.prog.mk's .y.c rule does), lex over lang.l,
# file2c over kernconf.tmpl. The reference build's config is this binary --
# running it on sys/amd64/conf/BZL generates the kernel compile directory
# (the opt_*.h family, config.c, env.c, hints.c, force-dynamic-hack.c).

yacc_generate(
    name = "grammar",
    src = "config.y",
    args = "-d",
    produced = ["y.tab.c", "y.tab.h"],
    outs = ["config.c", "y.tab.h"],
)

lex_generate(
    name = "scanner",
    src = "lang.l",
    args = "-olang.c",
    produced = ["lang.c"],
    outs = ["lang.c"],
)

genrule(
    name = "kernconf",
    srcs = ["kernconf.tmpl"],
    outs = ["kernconf.c"],
    cmd = "$(location //usr.bin/file2c:file2c) 'char kernconfstr[] = {' ',0};' < $(location kernconf.tmpl) > $(RULEDIR)/kernconf.c",
    tools = ["//usr.bin/file2c:file2c"],
)

cc_binary(
    # a host tool: only really built in the exec configuration, as a genrule tool
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    name = "config",
    srcs = [
        "main.cc",
        "mkmakefile.cc",
        "mkheaders.c",
        "mkoptions.cc",
        ":grammar",
        ":scanner",
        ":kernconf",
        "config.h",
        "configvers.h",
    ],
    includes = ["usr.sbin/config"],
    copts = [
        "-I.",
        "-I$(GENDIR)",
        "-I$(GENDIR)/usr.sbin/config",
        "-Iusr.sbin/config",
    ],
    deps = [
        "//lib/libc:legacy",
        "//tools/build/cross-build:nbtool",
        "//tools/build/cross-build:bitcount",
    ],
    linkopts = ["-pthread"],
    linkstatic = True,
)
