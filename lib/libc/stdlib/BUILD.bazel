load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# liblegacy's stdlib slice: the getopt family and strtonum, compiled against
# the real libc headers with the cross-build shims layered after them (the
# reference's tools-build stage puts them in liblegacy.a). The staged include
# surface lives in //lib/libc (legacyinc), spelled as -I copts here.
cc_library(
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    name = "legacy",
    srcs = [
        "getopt.c",
        "getopt_long.c",
        "strtonum.c",
        "//lib/libc:legacyinc",
    ],
    copts = [
        "-Ilib/libc/legacyinc",
        "-I$(GENDIR)/lib/libc/legacyinc",
    ],
    defines = [
        "__DBINTERFACE_PRIVATE",
        "HAVE_VIS=0",
        "HAVE_SVIS=0",
    ],
    deps = [
        "//tools/build/cross-build:progname",
        "//tools/build/cross-build:fgetln",
        "//tools/build/cross-build:bitcount",
        "//tools/build/cross-build:nbtool",
    ],
)

# recallocarray.c serves the bootstrap tools' libopenbsd (imsg/ohash).
exports_files(["recallocarray.c"])
