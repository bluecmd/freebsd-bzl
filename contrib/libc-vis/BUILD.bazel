load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# liblegacy's vis slice (vis.c/unvis.c compiled into liblegacy.a with
# HAVE_VIS/HAVE_SVIS 0 -- the tools link their names from the tree, not
# glibc's). The staged include surface lives in //lib/libc (legacyinc),
# spelled as -I copts here.
cc_library(
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    name = "legacy",
    srcs = [
        "vis.c",
        "unvis.c",
        "//lib/libc:legacyinc",
    ],
    hdrs = ["vis.h"],
    copts = [
        "-Ilib/libc/legacyinc",
        "-I$(GENDIR)/lib/libc/legacyinc",
    ],
    defines = [
        "__DBINTERFACE_PRIVATE",
        "HAVE_VIS=0",
        "HAVE_SVIS=0",
    ],
    deps = [
        "//tools/build/cross-build:progname",
        "//tools/build/cross-build:fgetln",
        "//tools/build/cross-build:bitcount",
        "//tools/build/cross-build:nbtool",
    ],
)

exports_files(["vis.h"])
