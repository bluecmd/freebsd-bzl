load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# liblegacy's pwcache slice, compiled in the exec configuration for the
# tree's host tools (the reference's tools-build stage puts it in
# liblegacy.a with -D__DBINTERFACE_PRIVATE and vis off). The staged include
# surface lives in //lib/libc (legacyinc) -- spelled as -I copts here, the
# piece's own package has none of it.
cc_library(
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    name = "legacy",
    srcs = ["pwcache.c", "//lib/libc:legacyinc"],
    hdrs = ["pwcache.h"],
    copts = [
        "-Ilib/libc/legacyinc",
        "-I$(GENDIR)/lib/libc/legacyinc",
    ],
    defines = [
        "__DBINTERFACE_PRIVATE",
        "HAVE_VIS=0",
        "HAVE_SVIS=0",
    ],
    deps = [
        "//tools/build/cross-build:progname",
        "//tools/build/cross-build:fgetln",
        "//tools/build/cross-build:bitcount",
        "//tools/build/cross-build:nbtool",
    ],
)

exports_files(["pwcache.h"])
