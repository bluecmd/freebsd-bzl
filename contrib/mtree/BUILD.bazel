load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The mtree spec parser makefs(8) borrows from contrib/mtree (getid/misc/spec
# -- the reference's obj-tools makefs build compiles the same files; the
# kernel-tree -I roots they need come from makefs_includes, the makefs root
# from //usr.sbin/makefs:headers).
cc_library(
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    name = "mtree",
    srcs = [
        "getid.c",
        "misc.c",
        "spec.c",
    ],
    hdrs = [
        "mtree.h",
        "extern.h",
        "//contrib/mknod:pack_dev.h",
    ],
    defines = [
        "MAKEFS",
        "HAVE_ZFS",
        "_WANT_MSDOSFS_INTERNALS",
        "HAVE_STRUCT_STAT_ST_FLAGS=1",
    ],
    deps = [
        "//usr.sbin/makefs:headers",
        "//:makefs_includes",
        "//lib/libc:legacy",
        "//lib/libnetbsd:netbsd",
        "//lib/libsbuf:sbuf",
        "//tools/build/cross-build:progname",
        "//tools/build/cross-build:bitcount",
        "//tools/build/cross-build:nbtool",
    ],
)

exports_files([
    "getid.c",
    "misc.c",
    "spec.c",
])
