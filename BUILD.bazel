        "//sys/amd64/include:machine_include",
        "//sys/x86/include:x86_include",
        "//sys/i386/include:i386_include",
    ],
)

# What config(8) reads to generate the compile directory: the config file
# chain (BZL -> FIRECRACKER -> std.*), the files/options databases and the
# Makefile template of sys/conf, all of sys/amd64/conf.
# un-namespace.h is generated upstream; the bootstrap ships a reduced copy
# that getopt.c's un-namespacing includes.
exports_files([
    "tools/build/libc-bootstrap/namespace.h",
    "tools/build/libc-bootstrap/libc_private.h",
    "tools/build/libc-bootstrap/un-namespace.h",
    "include/getopt.h",
    "sys/sys/queue.h",
    "tools/build/bootstrap-m4/inittokenizer.c",
])

filegroup(
    name = "config_inputs",
    srcs = glob(
        [
            "sys/conf/**",
            "sys/amd64/conf/**",
        ],
        allow_empty = True,
    ),
)

# The bus-interface descriptions (makeobjops.awk inputs) and the generator
# scripts the kernel's generators are driven by.
exports_files(glob(["sys/**/*_if.m"]))
exports_files(glob(["sys/tools/*.awk", "sys/tools/*.sh"], allow_empty = True))
# Generator scripts and one-off inputs the sys/BZL genrules drive (newvers.sh
# also reads sys/sys/param.h for RELDATE and the tree's COPYRIGHT for its year).
exports_files(glob(
    [
        "sys/kern/genoffset.sh",
        "sys/kern/genassym.sh",
        "sys/conf/vdso_amd64.ldscript",
        "sys/conf/vdso_amd64_ia32.ldscript",
        "sys/rpc/rpcsec_tls/*.x",
        "sys/conf/newvers.sh",
        "sys/sys/param.h",
        "COPYRIGHT",
    ],
    allow_empty = True,
))
# Every kernel header: the genrules that stage a tree for the tree's own
