# The compile-directory "symlink" include trees (machine/ -> sys/amd64/include,
# x86/ -> sys/x86/include, i386/ -> sys/i386/include in the reference): the
# kernel compile dir's -I$(GENDIR) must resolve machine/x86/i386 header paths,
# so sys/BZL stages copies of these include trees under those prefixes. The
# trees live in their own packages (their views are there too), hence the
# indirection.
filegroup(
    name = "amd64_include",
    srcs = ["//sys/amd64/include:tree"],
)
filegroup(
    name = "x86_include",
    srcs = ["//sys/x86/include:tree"],
)
filegroup(
    name = "i386_include",
    srcs = ["//sys/i386/include:tree"],
)
exports_files(glob(["sys/**/*.c"], allow_empty = True))
exports_files(glob(["sys/**/*.S"], allow_empty = True))

# Non-kernel sources makefs(8) compiles (the mtree spec parser, pack_dev,
# newfs_msdos's mkfs, libsa's zfs nvlist): exported so the makefs target can
# reach them by label (the reference's bootstrap compiled the same files).
exports_files([
    "sbin/newfs_msdos/mkfs_msdos.c",
    "stand/libsa/zfs/nvlist.c",
    "contrib/mtree/getid.c",
    "contrib/mtree/misc.c",
    "contrib/mtree/spec.c",
    "contrib/mknod/pack_dev.c",
    "contrib/libc-vis/vis.c",
    "contrib/libc-vis/unvis.c",
    "contrib/libc-pwcache/pwcache.c",
    "contrib/libc-pwcache/pwcache.h",
    "lib/libutil/fparseln.c",
])

# One libc-side header the cross-build sys/types.h shim pulls
# (#include <sys/bitcount.h>, "Needed for bitstring"): exposed through the
# sys/sys include root, since no other kernel header may leak into the host
# tools' compiles (the reference built them against the legacy libc headers).
cc_library(
    name = "bitcount_header",
    hdrs = ["sys/sys/bitcount.h"],
    includes = ["sys/sys"],
)


# The makefs(8) include surface: the reference's obj-tools makefs compile
# pointed each kernel-tree backend at its own directory (-Istand/libsa,
# -Isys/cddl/boot, -Isys/fs/cd9660, -Isys/fs/msdosfs, -Isbin/newfs_msdos,
# -Icontrib/{mtree,mknod}) instead of a blanket -Isys, so the kernel's
# sys/param.h never shadowed the cross-build shims (whose include_next chain
# would otherwise fall into it). Carried as one interface library because
# include paths may only be set by the package that owns the directory.
cc_library(
    name = "makefs_includes",
    hdrs = glob(
            [
                "contrib/mtree/*.h",
                "contrib/mknod/*.h",
                "sbin/newfs_msdos/*.h",
                "stand/libsa/*.h",
                "stand/libsa/zfs/*.h",
                "sys/cddl/boot/zfs/*.h",
                "sys/fs/cd9660/*.h",
                "sys/fs/msdosfs/*.h",
            ],
            allow_empty = True,
    ) + [
        "//sys/fs/cd9660:headers",
        "//sys/fs/devfs:headers",
        "//sys/fs/msdosfs:headers",
        "//sys/fs/nfs:headers",
        "//sys/fs/nfsclient:headers",
        "//sys/fs/nfsserver:headers",
        "//sys/fs/procfs:headers",
        "//sys/fs/pseudofs:headers",
        "//sys/fs/tmpfs:headers",
    ],
    # zfs/fletcher.c and zfs/sha256.c are included textually by
    # usr.sbin/makefs/zfs/vdev.c ("zfs/fletcher.c"), not compiled standalone.
    textual_hdrs = [
        "sys/cddl/boot/zfs/fletcher.c",
        "sys/cddl/boot/zfs/sha256.c",
    ],
    includes = [
        "stand/libsa",
        "sys/cddl/boot",
        "sys/fs/cd9660",
        "sys/fs/msdosfs",
        "sbin/newfs_msdos",
        "contrib/mtree",
        "contrib/mknod",
    ],
)

# The kernel endgame: the reference's ld line over the loose objects of the
# compile groups, then the objcopy pair (kernel.full -> kernel.debug ->
# kernel). The vDSO link objects ride the link from the vdso genrules'
# outputs; force-dynamic-hack.pico sits between vnode_if.o and vers.o, where
# the reference's link line has it.
# The kernel endgame lives in sys/BZL (the reference build's compile
# directory, where kernel.full/kernel.debug/kernel are produced); this alias
# keeps the top-level //:kernel name the image build drives.
alias(
    name = "kernel",
    actual = "//sys/BZL:kernel",
)
