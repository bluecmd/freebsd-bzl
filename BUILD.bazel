load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Every header the kernel's TUs can reach (Bazel only puts declared files in
# the compile sandbox); hdrs alone add no include root, so nothing is
# shadowed. sys/ is the whole kernel's include surface -- the reference's
# -Isys with the compile directory's machine/x86/i386 symlinks spelled as
# plain include roots on the Bazel side.
cc_library(
    name = "kernel_headers",
    hdrs = glob(
            [
                "sys/**/*.h",
                "sys/**/*.inc",
            ],
            allow_empty = True,
    ) + [
        "//sys/amd64/amd64:headers",
        "//sys/compat/freebsd32:headers",
        "//sys/compat/ia32:headers",
        "//sys/compat/x86bios:headers",
        "//sys/contrib/ck/src:headers",
        "//sys/contrib/libb2:headers",
        "//sys/contrib/libnv:headers",
        "//sys/contrib/libsodium/src/libsodium/crypto_core/ed25519/ref10:headers",
        "//sys/contrib/libsodium/src/libsodium/crypto_onetimeauth/poly1305:headers",
        "//sys/contrib/libsodium/src/libsodium/crypto_onetimeauth/poly1305/donna:headers",
        "//sys/contrib/libsodium/src/libsodium/crypto_scalarmult/curve25519:headers",
        "//sys/contrib/libsodium/src/libsodium/crypto_scalarmult/curve25519/ref10:headers",
        "//sys/contrib/libsodium/src/libsodium/crypto_stream/chacha20:headers",
        "//sys/contrib/libsodium/src/libsodium/crypto_stream/chacha20/ref:headers",
        "//sys/contrib/x86emu:headers",
        "//sys/contrib/xz-embedded/linux/lib/xz:headers",
        "//sys/contrib/zlib:headers",
        "//sys/contrib/zstd/lib/common:headers",
        "//sys/contrib/zstd/lib/compress:headers",
        "//sys/contrib/zstd/lib/decompress:headers",
        "//sys/contrib/zstd/lib/freebsd:headers",
