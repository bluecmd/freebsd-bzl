load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])
# awk(1) (one-true-awk), as usr.bin/awk/Makefile builds it: the grammar goes
# through the tree's byacc, and proctab.c is generated by the maketab build
# tool from the grammar's header (the reference build's awk is this binary --
# the kernel-side generators call it).
cc_binary(
    name = "maketab",
    srcs = [
        "//contrib/one-true-awk:maketab.c",
        "//contrib/one-true-awk:awk.h",
        "//contrib/one-true-awk:proto.h",
        "awkgram.tab.h",
    ],
    copts = [
        "-DHAS_ISBLANK",
        "-I$(GENDIR)/usr.bin/awk",
        "-Icontrib/one-true-awk",
    ],
    linkstatic = True,
)

genrule(
    name = "awkgram",
    srcs = ["//contrib/one-true-awk:awkgram.y"],
    outs = ["awkgram.tab.c", "awkgram.tab.h"],
    cmd = """
        YACC=$$PWD/$(location //usr.bin/yacc:yacc)
        SRC=$$PWD/$(location //contrib/one-true-awk:awkgram.y)
        OUT=$$PWD/$(RULEDIR)
        mkdir g && cd g
        $$YACC -d -o awkgram.tab.c "$$SRC"
        mv awkgram.tab.c awkgram.tab.h "$$OUT/"
        cd .. && rm -rf g
    """,
    tools = ["//usr.bin/yacc:yacc"],
)

genrule(
    name = "proctab",
    srcs = [":awkgram.tab.h"],
    outs = ["proctab.c"],
    cmd = """
        MT=$$PWD/$(location :maketab)
        SRC=$$PWD/$(location :awkgram.tab.h)
        OUT=$$PWD/$(RULEDIR)
        "$$MT" "$$SRC" > "$$OUT/proctab.c"
    """,
    tools = [":maketab"],
)

cc_binary(
    name = "awk",
    srcs = [
        "//contrib/one-true-awk:b.c",
        "//contrib/one-true-awk:lex.c",
        "//contrib/one-true-awk:lib.c",
        "//contrib/one-true-awk:main.c",
        "//contrib/one-true-awk:parse.c",
        "//contrib/one-true-awk:run.c",
        "//contrib/one-true-awk:tran.c",
        "//contrib/one-true-awk:awk.h",
        "//contrib/one-true-awk:proto.h",
        "awkgram.tab.c",
        "awkgram.tab.h",
        "proctab.c",
    ],
    copts = [
        "-DHAS_ISBLANK",
        "-I$(GENDIR)/usr.bin/awk",
        "-Icontrib/one-true-awk",
        "-DFOPEN_MAX=64",
    ],
    linkopts = ["-lm"],
    linkstatic = True,
)
