load("//bazel/rules:yacc_lex.bzl", "lex_generate", "yacc_generate")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])
# awk(1) (one-true-awk), as usr.bin/awk/Makefile builds it: the grammar goes
# through the tree's byacc, and proctab.c is generated by the maketab build
# tool from the grammar's header (the reference build's awk is this binary --
# the kernel-side generators call it).
cc_binary(
    # a host tool: only really built in the exec configuration, as a genrule tool
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    name = "maketab",
    srcs = [
        "//contrib/one-true-awk:maketab.c",
        "//contrib/one-true-awk:awk.h",
        "//contrib/one-true-awk:proto.h",
        "awkgram.tab.h",
    ],
    copts = [
        "-DHAS_ISBLANK",
        "-I$(GENDIR)/usr.bin/awk",
        "-Icontrib/one-true-awk",
    ],
    linkstatic = True,
)

yacc_generate(
    name = "awkgram",
    src = "//contrib/one-true-awk:awkgram.y",
    args = "-d -o awkgram.tab.c",
    produced = ["awkgram.tab.c", "awkgram.tab.h"],
    outs = ["awkgram.tab.c", "awkgram.tab.h"],
)

genrule(
    name = "proctab",
    srcs = [":awkgram.tab.h"],
    outs = ["proctab.c"],
    cmd = '"$(location :maketab)" "$(location :awkgram.tab.h)" > "$(RULEDIR)/proctab.c"',
    tools = [":maketab"],
)

cc_binary(
    # a host tool: only really built in the exec configuration, as a genrule tool
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    name = "awk",
    srcs = [
        "//contrib/one-true-awk:b.c",
        "//contrib/one-true-awk:lex.c",
        "//contrib/one-true-awk:lib.c",
        "//contrib/one-true-awk:main.c",
        "//contrib/one-true-awk:parse.c",
        "//contrib/one-true-awk:run.c",
        "//contrib/one-true-awk:tran.c",
        "//contrib/one-true-awk:awk.h",
        "//contrib/one-true-awk:proto.h",
        "awkgram.tab.c",
        "awkgram.tab.h",
        "proctab.c",
    ],
    copts = [
        "-DHAS_ISBLANK",
        "-I$(GENDIR)/usr.bin/awk",
        "-Icontrib/one-true-awk",
        "-DFOPEN_MAX=64",
    ],
    linkopts = ["-lm"],
    linkstatic = True,
)
